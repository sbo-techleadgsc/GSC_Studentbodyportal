{
  "rewrites": [
    {
      "source": "/under-maintenance.html",
      "destination": "/under-maintenance.html"
    },
    {
      "source": "/api/maintenance",
      "destination": "/api/maintenance-check.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/maintenance"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://sites.google.com/view/gsc-studentcouncil/"
        }
      ]
    }
  ]
}